# Stage 1: Builder
FROM ubuntu:22.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    git \
    curl \
    zip \
    unzip \
    tar \
    pkg-config \
    ninja-build \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Clone and setup vcpkg for easy C++ dependency management
RUN git clone https://github.com/microsoft/vcpkg.git /vcpkg \
    && /vcpkg/bootstrap-vcpkg.sh -disableMetrics

# Install Google Cloud Spanner C++ SDK, gflags, and glog
# Note: This step builds gRPC, Protobuf, and Abseil from source and takes significant time.
RUN /vcpkg/vcpkg install "google-cloud-cpp[spanner]" gflags glog

# Copy our spanner benchmarking source
COPY spanner/ /app/spanner/

# Build the C++ benchmark client
RUN cmake -B /app/build -S /app/spanner -DCMAKE_TOOLCHAIN_FILE=/vcpkg/scripts/buildsystems/vcpkg.cmake -GNinja \
    && cmake --build /app/build

# Stage 2: Final lightweight image
FROM ubuntu:22.04

# Install basic runtime dependencies (e.g., ca-certificates for Spanner SSL)
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy the compiled binary
COPY --from=builder /app/build/benchmark_ycsb_spanner /app/benchmark_ycsb_spanner

# Copy the shared libraries generated by vcpkg
COPY --from=builder /vcpkg/installed/x64-linux/lib/ /usr/local/lib/

# Update the dynamic linker run-time bindings
RUN ldconfig

ENV GLOG_logtostderr=1
CMD ["/app/benchmark_ycsb_spanner"]
